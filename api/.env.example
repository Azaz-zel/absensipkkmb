# Koneksi Postgres untuk role app_api (bukan postgres/service role).
# Lokal: password dari supabase/seed.sql. Cloud: pakai connection string pooler dengan user app_api.<project-ref>.
DATABASE_URL=postgresql://app_api:app_api_local_dev@127.0.0.1:54322/postgres
# Alamat dengar API.
ADDR=127.0.0.1:8080
# Origin frontend yang boleh mengirim permintaan pengubah data (pisahkan dengan koma).
ALLOWED_ORIGINS=http://localhost:5173
# false hanya untuk http lokal. Di produksi (https) biarkan true.
COOKIE_SECURE=false
# Isi dengan folder hasil `npm run build` kalau API juga melayani frontend.
WEB_DIST=
